{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.title,\n            p.slug,\n            p.description,\n            p.price_cents,\n            p.product_type,\n            p.category_id,\n            c.name as category_name,\n            p.cover_image_id,\n            p.author_name,\n            p.country,\n            p.is_featured,\n            p.created_at\n        FROM store_products p\n        LEFT JOIN store_categories c ON p.category_id = c.id\n        WHERE p.is_active = TRUE AND p.is_sold = FALSE AND p.season = $1\n        ORDER BY p.is_featured DESC, p.created_at DESC\n        LIMIT $2 OFFSET $3\n        ",
